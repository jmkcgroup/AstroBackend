# --- Server ---------------------------------------------------
PORT=4000
NODE_ENV=development
# Frontend origin allowed by CORS and used in email links
FRONTEND_URL="http://localhost:3000"

# --- Database ---------------------------------------------
# Local development uses SQLite (a file, nothing to install):
DATABASE_URL="file:./dev.db"
# Production uses PostgreSQL, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/astroveda?schema=public"

# --- Auth (JWT in httpOnly cookies) ---------------------------
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
# Optional Google OAuth (leave empty to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (optional; emails are logged to console when unset) -
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="AstroVeda <no-reply@example.com>"
CONTACT_INBOX=""

# --- Astrology engine -----------------------------------------
# Directory with Swiss Ephemeris .se1 files (sepl_18, semo_18, seas_18 cover 1800-2400 AD)
SWISSEPH_EPHE_PATH="./ephe"
# Private directory for generated report PDFs
STORAGE_DIR="./storage"
# Production only, when API and site share a parent domain, e.g. ".astroveda.com"
COOKIE_DOMAIN=""

# --- Development seed (optional) ------------------------------
# `npm run db:seed` creates this admin account when both are set.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# --- Razorpay (Test Mode keys during development) -------------
# Paste keys here directly; never share them in chat or commit them.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
